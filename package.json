{
  "name": "revnit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seed:demo": "node scripts/generate-demo-seed.ts",
    "test:db": "node scripts/test-database.mjs",
    "db:sql": "{ echo \"-- Complete database setup: every migration plus the categories, in order.\"; echo \"-- Generated by npm run db:sql. Paste it all into Supabase → SQL Editor → New query → Run.\"; echo; cat supabase/migrations/*.sql supabase/seed.sql; echo \"notify pgrst, 'reload schema';\"; } > supabase/setup.sql && echo \"Wrote supabase/setup.sql\"",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.64.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
