# Public site URL (used for auth redirects and sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used to sign download links and record payments. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay → Settings → API keys (use test keys until launch)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Settings → Webhooks (event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=

# Optional: email notifications (request shipped, family updated, receipts) via Resend
RESEND_API_KEY=
EMAIL_FROM="Revnit <hello@revnit.com>"
